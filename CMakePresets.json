{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux debug (CPU, OpenGL, OpenGL ES, Vulkan, transpiler, tests)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux release; also provides the host tc-transpile for Android builds",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "android-arm64",
      "displayName": "Android arm64-v8a (needs ANDROID_NDK_HOME and a built linux-release preset)",
      "inherits": "base",
      "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-29",
        "ANDROID_STL": "c++_static",
        "TC_BUILD_TRANSPILER": false,
        "TC_BUILD_TESTS": false,
        "TC_TRANSPILER_EXECUTABLE": "${sourceDir}/build/linux-release/transpiler/tc-transpile"
      }
    }
  ],
  "buildPresets": [
    {"name": "linux-debug", "configurePreset": "linux-debug"},
    {"name": "linux-release", "configurePreset": "linux-release"},
    {"name": "android-arm64", "configurePreset": "android-arm64"}
  ],
  "testPresets": [
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug",
      "output": {"outputOnFailure": true}
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release",
      "output": {"outputOnFailure": true}
    }
  ]
}
